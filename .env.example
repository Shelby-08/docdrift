GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER_KEY_HERE\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
PORT=3000
LOG_LEVEL=INFO
MAX_FILE_BYTES=1000000
MAX_SNAPSHOT_FILES=200
MAX_TOTAL_SNAPSHOT_BYTES=10000000
MAX_TREE_REQUESTS=200
GITHUB_API_TIMEOUT_SECONDS=15
MAX_JOB_ATTEMPTS=3
MAX_CONCURRENT_JOBS=1
DOCSENTRY_CHECK_NAME=DocSentry
DOCSENTRY_MAX_ANNOTATIONS=25
DOCSENTRY_MAX_SUMMARY_FINDINGS=30
DOCSENTRY_PUBLISH_ENABLED=true
AI_REVIEW_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_BACKEND=ollama
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
AI_REVIEW_TOTAL_BUDGET_SECONDS=180
AI_REVIEW_MAX_BATCH_ITEMS=5
AI_REVIEW_MAX_BATCH_CHARS=12000
AI_REVIEW_MAX_OUTPUT_TOKENS=1200
AI_REVIEW_MAX_RETRIES=0

# Single process only: queues, dedup and locks are in memory. Run ONE Uvicorn worker.
