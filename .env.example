GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER_KEY_HERE\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
PORT=3000
LOG_LEVEL=INFO
MAX_FILE_BYTES=1000000
MAX_SNAPSHOT_FILES=200
MAX_TOTAL_SNAPSHOT_BYTES=10000000
MAX_TREE_REQUESTS=200
GITHUB_API_TIMEOUT_SECONDS=15
MAX_JOB_ATTEMPTS=3
MAX_CONCURRENT_JOBS=1
